---
// Signature mascot (§14): the AI Pet Usage golden retriever, reused verbatim as a subtle, persistent desktop
// easter egg — decorative only: not a chatbot, widget, CTA, notification or assistant (docs/DECISIONS.md,
// 2026-09-27 "Signature mascot", M4-1.5).
//
// Provenance: F-e-u-e-r/ai-pet-usage · Sources/PetCore/PixelArt.swift · main b7c4b72 (2026-09-25) —
// `PixelPets.goldenRetriever` frames `dogIdleA`, `dogIdleB`, `dogEarTwitchA` and its palette, copied character
// for character (20 × 18 grid, '.' = transparent). Original pixel art © Eric So — published there under
// AGPL-3.0-only, used here as the site's own content. Do not redraw or reinterpret; re-sync from that file.
//
// Rendering: build-time run-length encoding → one <path> per colour per frame (15 paths, ~0.8 KB gzip); no
// runtime JS, no images. Idle A/B at the app's 1.4 fps plus the ear-twitch micro-animation for 200 ms every
// 8.571 s (= 6 idle cycles, aligned to an idle-A slot so the twitch never overlays idle B's tail). Static idle A
// under prefers-reduced-motion (the app's `staticPose` rule). Desktop-only (≥ 1280 px) until the M4-6 mobile review.
const PALETTE: Record<string, string> = {
  A: '#E8A33D', // 主體金黃
  M: '#C77F23', // 深金(垂耳/陰影)
  C: '#F6DFAE', // 奶油(胸口/腿間)
  K: '#26221E', // 眼/鼻/項圈
  P: '#E4577E', // 舌
};
const GRID = { width: 20, height: 18 } as const;
const FRAMES = {
  idleA: [
    '.............AA.....',
    '.....MM.....AAAA....',
    '....MMMMAAAAAAAA....',
    '....MMMAAAAAAAAAA...',
    '.....MMAAAAAAKKAA...',
    '.......AAAAAAKKAAKK.',
    '.......AAAAAAAAAAKK.',
    'AA.....AAAAAAAAAA...',
    'AAA....AAAAAAAAPPP..',
    '.AA....KKKKKKKK.PP..',
    '...AAAAAAAAAAAA.PP..',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAAAAA.....',
    '..AAAAAAAAAAAAA.....',
    '...AACAACAACAA......',
    '...AA.AA.AA.AA......',
    '....................',
  ],
  idleB: [
    '..............AA....',
    '.....MM.....AAAA....',
    '....MMMMAAAAAAAA....',
    '....MMMAAAAAAAAAA...',
    '.....MMAAAAAAKKAA...',
    '.......AAAAAAKKAAKK.',
    '.......AAAAAAAAAAKK.',
    '.......AAAAAAAAAA...',
    'AAA....AAAAAAAAPPP..',
    '.AA....KKKKKKKK.PP..',
    '...AAAAAAAAAAAA.PP..',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAAAAA.....',
    '..AAAAAAAAAAAAA.....',
    '...AACAACAACAA......',
    '...AA.AA.AA.AA......',
    '....................',
  ],
  earTwitchA: [
    '....MM.......AA.....',
    '....MM......AAAA....',
    '....MMMMAAAAAAAA....',
    '....MMMAAAAAAAAAA...',
    '.....MMAAAAAAKKAA...',
    '.......AAAAAAKKAAKK.',
    '.......AAAAAAAAAAKK.',
    'AA.....AAAAAAAAAA...',
    'AAA....AAAAAAAAPPP..',
    '.AA....KKKKKKKK.PP..',
    '...AAAAAAAAAAAA.PP..',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAACCC.....',
    '..AAAAAAAAAAAAA.....',
    '..AAAAAAAAAAAAA.....',
    '...AACAACAACAA......',
    '...AA.AA.AA.AA......',
    '....................',
  ],
} as const;

// Run-length encode a frame: per palette colour, one path of horizontal runs (`M x y h w v1 h-w z`).
// Fails the build on any drift from the source contract (row count, row length, unknown colour key).
const paths = (name: string, rows: readonly string[]): string => {
  if (rows.length !== GRID.height) throw new Error(`PetCompanion: ${name} has ${rows.length} rows, expected ${GRID.height}`);
  const runs: Record<string, string[]> = {};
  rows.forEach((row, y) => {
    if (row.length !== GRID.width) throw new Error(`PetCompanion: ${name} row ${y} has ${row.length} cells, expected ${GRID.width}`);
    for (let x = 0; x < GRID.width; ) {
      const ch = row[x];
      if (ch === '.') { x += 1; continue; }
      if (!(ch in PALETTE)) throw new Error(`PetCompanion: ${name} row ${y} col ${x}: unknown colour key "${ch}"`);
      let w = 1;
      while (x + w < GRID.width && row[x + w] === ch) w += 1;
      (runs[ch] ??= []).push(`M${x} ${y}h${w}v1h-${w}z`);
      x += w;
    }
  });
  return Object.entries(runs).map(([ch, d]) => `<path fill="${PALETTE[ch]}" d="${d.join('')}"/>`).join('');
};
---
<div class="pet" aria-hidden="true">
  <svg class="pet__sprite" viewBox={`0 0 ${GRID.width} ${GRID.height}`} width="60" height="54" shape-rendering="crispEdges" focusable="false">
    <g class="f f-a" set:html={paths('idleA', FRAMES.idleA)} />
    <g class="f f-b" set:html={paths('idleB', FRAMES.idleB)} />
    <g class="f f-t" set:html={paths('earTwitchA', FRAMES.earTwitchA)} />
  </svg>
</div>
<style>
  /* Fixed lower-left signature. 16 px inset: at ≥ 1280 px every content / footer text block starts ≥ 96 px from
     the viewport edge while the sprite spans 16–76 px, so the 16 px clearance contract holds by geometry
     (tests/e2e/pet.spec.ts asserts it at 1280 / 1440 / 1920 / 2560). Hidden below 1280 px until M4-6. */
  .pet {
    position: fixed; left: 1rem; bottom: 1.1rem; z-index: var(--z-pet);
    display: none; line-height: 0; opacity: 0.9; pointer-events: none;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }
  .pet__sprite { display: block; }
  /* Frame groups: exactly one visible at any time. Period 8.571 s = 12 idle slots of 0.714 s (1.4 fps);
     idle A owns the even slots, idle B the odd ones, the ear twitch the first 200 ms of the cycle. */
  .pet .f { visibility: hidden; }
  .pet .f-a { animation: pet-a 8.571s step-end infinite; }
  .pet .f-b { animation: pet-b 8.571s step-end infinite; }
  .pet .f-t { animation: pet-t 8.571s step-end infinite; }
  @keyframes pet-a {
    0% { visibility: hidden; } 2.333% { visibility: visible; } 8.333% { visibility: hidden; }
    16.667% { visibility: visible; } 25% { visibility: hidden; } 33.333% { visibility: visible; } 41.667% { visibility: hidden; }
    50% { visibility: visible; } 58.333% { visibility: hidden; } 66.667% { visibility: visible; } 75% { visibility: hidden; }
    83.333% { visibility: visible; } 91.667% { visibility: hidden; } 100% { visibility: hidden; }
  }
  @keyframes pet-b {
    0% { visibility: hidden; } 8.333% { visibility: visible; } 16.667% { visibility: hidden; }
    25% { visibility: visible; } 33.333% { visibility: hidden; } 41.667% { visibility: visible; } 50% { visibility: hidden; }
    58.333% { visibility: visible; } 66.667% { visibility: hidden; } 75% { visibility: visible; } 83.333% { visibility: hidden; }
    91.667% { visibility: visible; } 100% { visibility: hidden; }
  }
  @keyframes pet-t {
    0% { visibility: visible; } 2.333% { visibility: hidden; } 100% { visibility: hidden; }
  }
  @media (min-width: 1280px) { .pet { display: block; } }
  @media (prefers-reduced-motion: reduce) {
    .pet .f { animation: none; }
    .pet .f-a { visibility: visible; }
  }
</style>
