---
// Pet companion (§14): desktop-only MVP idle/walk, hidden on mobile, static under reduced-motion.
---
<div class="pet" aria-hidden="true">
  <svg viewBox="0 0 16 12" width="52" height="39" shape-rendering="crispEdges" class="pet__sprite">
    <g fill="#35e0a1">
      <rect x="2" y="3" width="1" height="2" />
      <rect x="4" y="3" width="1" height="2" />
      <rect x="2" y="5" width="6" height="4" />
      <rect x="8" y="6" width="3" height="3" />
      <rect x="11" y="4" width="1" height="5" class="pet__tail" />
    </g>
    <g fill="#04120c">
      <rect x="3" y="6" width="1" height="1" />
      <rect x="6" y="6" width="1" height="1" />
    </g>
  </svg>
</div>
<style>
  .pet {
    position: fixed; left: 1.25rem; bottom: 1.1rem; z-index: var(--z-pet);
    opacity: 0.85; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
    animation: petbob 3.6s var(--ease-in-out) infinite;
  }
  .pet__tail { transform-box: fill-box; transform-origin: bottom; animation: pettail 2.4s var(--ease-in-out) infinite; }
  @keyframes petbob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }
  @keyframes pettail { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(-12deg); } }
  @media (max-width: 1024px) { .pet { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .pet { animation: none; }
    .pet__tail { animation: none; }
  }
</style>
