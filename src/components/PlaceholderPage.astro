---
// "In Preparation" page state: the route is part of the IA, the content has not launched.
// HTTP 200, robots noindex, nofollow, never in the sitemap. The route must also be listed in
// PLACEHOLDER_ROUTES (src/data/routes.mjs) — BaseLayout and the dist gate enforce the policy from there,
// so a page cannot be indexable by accident. Not to be confused with /under-maintenance/ (degraded service).
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  /** Meta description; defaults to the message. */
  description?: string;
  /** Lead line; the recommended copy is the default. */
  message?: string;
  plannedContent?: string[];
  /** A concrete planned-but-unpublished item, e.g. the first article. Never presented as published. */
  firstItem?: { label: string; title: string; note?: string };
  backLink?: { href: string; label: string };
  active?: string;
}

const {
  title,
  description,
  message = 'This section is being prepared.',
  plannedContent = [],
  firstItem,
  backLink = { href: '/', label: 'Return home' },
  active,
} = Astro.props;
---
<BaseLayout title={title} description={description ?? message} robots="noindex, nofollow" active={active} boot={false}>
  <section class="prep section container container--narrow">
    <header class="page-head">
      <p class="eyebrow">{title} <span class="state-tag">In preparation</span></p>
      <h1>{message}</h1>
    </header>
    {plannedContent.length > 0 && (
      <div class="card panel">
        <p class="eyebrow">Planned content</p>
        <ul class="planned">
          {plannedContent.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    )}
    {firstItem && (
      <p class="first subtle">
        {firstItem.label}: <em>{firstItem.title}</em>{firstItem.note && <> — {firstItem.note}</>}
      </p>
    )}
    <p class="foot subtle">Nothing in this section is published yet. <a href={backLink.href}>{backLink.label}</a></p>
  </section>
</BaseLayout>
<style>
  .page-head { margin-bottom: 2rem; }
  .page-head h1 { font-size: var(--text-3xl); margin: 0.5rem 0 0.75rem; text-wrap: balance; }
  .state-tag { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-accent-contrast); background: var(--c-accent-dim); border-radius: var(--radius-pill); padding: 0.12rem 0.5rem; margin-left: 0.5rem; vertical-align: middle; }
  .panel { padding: 1.75rem; }
  .planned { columns: 2; column-gap: 2rem; padding-left: 1.1rem; margin-top: 1rem; color: var(--c-fg-muted); }
  .planned li { margin-bottom: 0.5rem; break-inside: avoid; }
  .first { margin-top: 1.5rem; }
  .foot { margin-top: 1.5rem; font-size: var(--text-sm); }
  @media (max-width: 640px) { .planned { columns: 1; } }
</style>
