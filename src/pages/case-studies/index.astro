---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Case Studies" description="Case studies in business transformation and applied AI — problem, design decisions, validation, governance, adoption and evidence." active="/case-studies/" boot={false}>
  <section class="section container">
    <header class="page-head">
      <p class="eyebrow">Case Studies</p>
      <h1>Understand a problem, build the solution, prove it works.</h1>
      <p class="lead">Each case follows one structure: problem, design decisions, what I built, how I validated it, governance, adoption and evidence.</p>
    </header>
    <div class="grid">
      {cases.map((c) => <CaseCard entry={c} featured={c.data.featured} headingLevel="h2" />)}
    </div>
  </section>
</BaseLayout>
<style>
  .page-head { max-width: 46rem; margin-bottom: 2.5rem; }
  .page-head h1 { font-size: var(--text-3xl); margin: 0.5rem 0 0.75rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
