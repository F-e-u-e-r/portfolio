    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
